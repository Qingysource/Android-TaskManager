<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        [OVERLAY-v1] 浮窗权限组（回退浮窗时：删掉 SYSTEM_ALERT_WINDOW 一条即可；
                     FOREGROUND_SERVICE / FOREGROUND_SERVICE_SPECIAL_USE / POST_NOTIFICATIONS
                     属于"UIService 常驻前台"，不要再删）
        - SYSTEM_ALERT_WINDOW             画"其他应用上方"的窗口，属于特殊应用权限，
                                          只能引导用户去系统设置里手动开；
        - FOREGROUND_SERVICE              UIService 是常驻前台服务：界面关掉后它仍要采集数据、
                                          维持上游服务与身份，普通后台服务会被系统回收；
        - FOREGROUND_SERVICE_SPECIAL_USE  targetSdk 34+ 的前台服务必须声明用途类型；
        - POST_NOTIFICATIONS              前台服务通知（Android 13+ 未授权时通知不显示，
                                          服务本身照常运行，只是用户看不到"正在后台运行"）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        内存转储默认由 root / shell 后端进程直接写到 /storage/emulated/<用户 id>/dump/，
        这条权限平时用不上；只有普通权限后端写不进去（EACCES）时，页面才跳一次
        「所有文件访问」授权页并重试，所以这里必须声明它（不声明则系统页里没有本应用开关）。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
        QUERY_ALL_PACKAGES（应用历史记录页）：
        Android 11+ 包可见性限制下，普通查询只能看到"可见包"；应用历史记录页要求列出
        本机安装的全部应用（含系统应用），必须声明这条。任务管理器属于"设备管理"类用途，
        不用于投放广告 / 搜索推荐。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        PACKAGE_USAGE_STATS（应用历史记录页的按应用网络流量）：
        它是 appop 型权限，声明之后由 root / shell 用
        `appops set com.android.taskmanager GET_USAGE_STATS allow` 授予，
        NetworkStatsManager.queryDetailsForAll 才能按 uid 读到统计。
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!--
        Shizuku 授权口径（缺一条都拿不到 binder）：
        - API_V23：声明本应用按 Shizuku 的运行时权限模型申请授权；
        - 下面的 ShizukuProvider：Shizuku 是通过 ContentProvider 把服务 binder
          送进应用进程的，没声明它，Shizuku.pingBinder() 永远 false，
          表现为"请求权限"立刻失败。

        [SHIZUKU-v1] 回退时：删掉这条 uses-permission 与 application 里的 <provider>，
                    并把 ShizukuManager 一起摘掉即可，不影响其它功能。
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
        包可见性声明（Android 11+ 必需）。

        要判断"Shizuku 装没装""服务在不在跑"，以及要能 startActivity 打开 Shizuku 让用户
        启动服务，就必须让本应用"看得见" moe.shizuku.privileged.api。
        没有这段声明，PackageManager.getPackageInfo / getLaunchIntentForPackage 会直接抛
        NameNotFound，表现为"永远显示未安装 Shizuku"，而设备上其实是装了的。
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!--
        应用整体配置：备份规则、图标、主题。
        界面完全由 Compose 绘制，这里的主题主要作用于启动窗口与系统装饰。
    -->
    <application
        android:name=".TaskManagerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskManager">

        <!--
            Shizuku 的 binder 入口（必需，缺了它授权永远失败）。

            authorities 用 ${applicationId}.shizuku 是 Shizuku 的固定约定，
            由 rikka.shizuku:provider 里的 ShizukuProvider 负责转发 binder；
            android:permission 把 provider 保护起来，别的应用读不到本进程的这条通道。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            「打开文件所在的位置」的出口：把 base.apk / 原生可执行文件以 content:// 形式
            交给文件管理器或安装器。
            只对本次 Intent 拿到 FLAG_GRANT_READ_URI_PERMISSION 的应用开放，不做全局可读。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.processfiles"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/process_file_paths" />

        </provider>

        <!--
            应用唯一入口 Activity：单 Activity + Compose 多页面导航，
            进入后由 MainActivity.onCreate() 启动下列服务并初始化权限通道。
        -->
        <activity
            android:name="com.android.taskmanager.MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            UI 辅助服务：数据中枢（设置持久化 + 上游服务维护 + 轮询 + [OVERLAY-v1] 浮窗管理）。

            **常驻前台服务**：界面只是它的视图，服务本身不依赖 Activity 存活，
            由 MainActivity 用 startForegroundService 拉起，onCreate/onStartCommand 里立即
            startForeground，并返回 START_STICKY（被系统回收后自动重建）。
            - stopWithTask="false"：用户从最近任务里划掉应用，服务继续运行（默认值也是 false，
                                   这里显式写出，避免以后被误改）；
            - foregroundServiceType="specialUse"：targetSdk 34+ 必须声明类型，
                                   Manifest 用 <property> 说明具体用途。
            （浮窗只是在这条服务之上额外挂了一个窗口，开/关只改通知文案。）
        -->
        <service
            android:name="com.android.taskmanager.service.UIService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="task_manager_data_hub" />

        </service>

        <!-- Android Framework 数据服务（预留：进程、内存、CPU 等数据源） -->
        <service
            android:name="com.android.taskmanager.data.AndroidService"
            android:exported="false" />

        <!-- Linux 数据服务（预留：/proc 数据源，需要 Root 或 Shizuku 授权） -->
        <service
            android:name="com.android.taskmanager.data.LinuxService"
            android:exported="false" />

        <!--
            无障碍置顶窗口的授权入口（设置页「使用无障碍权限置顶」）。

            作用：系统里必须先有这一项，用户才能去无障碍设置页把本应用的服务打开；
            没有这条声明，就不存在"无障碍权限"这个可授予的状态。
            - permission=BIND_ACCESSIBILITY_SERVICE：只允许系统绑定，别的应用起不来；
            - exported=true：无障碍设置页由系统进程枚举服务，必须可被系统看见（已被上面的
              permission 保护，普通应用仍绑不上）；
            - meta-data 指向 res/xml/a11y_top_window.xml：声明事件类型与"不读窗口内容"。
            服务连上之后由它自己 addView 建 TYPE_ACCESSIBILITY_OVERLAY 置顶窗口（界面与悬浮窗完全一样）。
        -->
        <service
            android:name="com.android.taskmanager.service.A11yTopWindowService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_top_window" />

        </service>

        <!--
            TODO(预留): 接入真实数据采集后需要补充权限声明，例如：
            QUERY_ALL_PACKAGES（应用历史、启动项）、PACKAGE_USAGE_STATS（使用统计，需用户特殊授权）、
            REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 等。当前保持最小权限。
        -->
    </application>

</manifest>
